{
  "name": "stash-phash-inspector",
  "version": "0.5.0",
  "description": "Standalone tool to visualize and reproduce Stash's video perceptual hash algorithm",
  "main": "main.js",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maista6969/stash-phash-inspector.git"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "node --test \"test/**/*.test.js\"",
    "stash-check": "node tools/stash-check.js",
    "dist": "electron-builder --publish=never",
    "release": "electron-builder --publish=always",
    "web:build": "pnpm --filter stash-phash-inspector-web run build",
    "web:start": "pnpm run web:build && pnpm dlx serve web/dist",
    "web:check": "node tools/ui-check.js",
    "app:check": "node tools/ui-check.js --electron"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "app.stash.phash-inspector",
    "productName": "Stash pHash Inspector",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "shared/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Maista6969",
      "repo": "stash-phash-inspector"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
